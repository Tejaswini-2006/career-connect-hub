# Career Connect Hub - Environment Variables Template
# Copy this file to '.env' for local development configuration

# Application Information
VITE_APP_NAME="Career Connect Hub"
VITE_APP_DESCRIPTION="Modern Job & Recruitment Platform"
VITE_APP_URL="http://localhost:8080"

# API Base URL (if connecting to external REST/GraphQL backend)
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_ANALYTICS=false
